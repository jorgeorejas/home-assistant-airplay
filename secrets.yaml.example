# Copy to secrets.yaml and fill in. Never commit secrets.yaml.
wifi_ssid: ""
wifi_password: ""

# vivla.ai voice bridge URL.
# Local dev (running mastra locally with the gateway): ws://<your-mac-ip>:3002/voice
# Prod: wss://api.vivla.ai/voice (once vivla-intelligence ships the gateway)
vivla_bridge_url: "ws://192.168.1.10:3002/voice"

# Bearer token the bridge expects (matches DEVICE_TOKEN env var on the gateway).
vivla_device_token: ""
