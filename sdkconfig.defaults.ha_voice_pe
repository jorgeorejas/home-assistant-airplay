# DenAir sdkconfig overrides for the HA Voice PE board.
# Layered on top of sdkconfig.defaults + sdkconfig.defaults.esp32s3.
# Build invocation:
#   idf.py set-target esp32s3
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.ha_voice_pe" reconfigure
#   idf.py build

# Board selection — explicitly unset the Kconfig-default so the choice
# flips to HA_VOICE_PE instead of falling through to ESP32S3_GENERIC.
# CONFIG_BOARD_ESP32S3_GENERIC is not set
CONFIG_BOARD_HA_VOICE_PE=y
CONFIG_DAC_TLV320AIC3204=y

# --- AirPlay 1 (classic) mode ---
# DenAir's UX relies on bidirectional volume: turning the encoder should
# move the iPhone's AirPlay slider. That round-trip uses DACP, which iOS
# only emits in AirPlay 1. Forcing AP1 also unlocks play/pause and track
# skip controls from the device. Trade-off accepted: no Home app /
# HomeKit "Hey Siri play on DenAir", no multi-room sync. Both are
# explicit non-goals for Phase 1.
CONFIG_AIRPLAY_FORCE_V1=y

# --- GPIO overrides for HA Voice PE (see components/boards/ha_voice_pe/iot_board.h
#     for the authoritative map; these mirror them into Kconfig so pieces of
#     the upstream codebase that still read CONFIG_* Kconfig knobs see the
#     same values) ---
CONFIG_I2S_BCK_IO=8
CONFIG_I2S_WS_IO=7
CONFIG_I2S_DO_IO=10
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_GND_IO=-1
CONFIG_I2S_VCC_IO=-1

CONFIG_DAC_I2C_SDA=5
CONFIG_DAC_I2C_SCL=6

CONFIG_JACK_GPIO=17
CONFIG_MUTE_GPIO=-1
CONFIG_LED_STATUS_GPIO=-1
CONFIG_LED_ERROR_GPIO=-1
CONFIG_LED_RGB_GPIO=-1

# --- HA Voice PE is an ESP32-S3R8: 16 MB flash + 8 MB octal PSRAM at 80 MHz ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# --- Features we do NOT want for DenAir ---
# The 12-LED ring is driven by our own engine (Phase 2), not the upstream
# single-LED status indicator. Upstream has no master LED_ENABLED knob; the
# GPIO knobs above at -1 already keep the pins unallocated.
# Skip the OLED display entirely; saves heap + flash + the u8g2 footprint.
CONFIG_DISPLAY_ENABLED=n
# No Bluetooth on this build path.
# (No explicit CONFIG_BT here — default off on S3, confirmed by upstream
#  sdkconfig.defaults.esp32s3 not setting it.)

# --- Console path ---
# USB_CDC as the primary console produced no output on this ESP32-S3 + native
# USB setup, even though the Kconfig was definitely taking. USB_SERIAL_JTAG
# as the SECONDARY console (with UART primary) is the config that actually
# produced logs on the earlier generic-target smoke test, so we use it here.
# (Both are seen as /dev/cu.usbmodem* on macOS; JTAG just works more
# reliably as a log output on the ESP32-S3 ROM.)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
